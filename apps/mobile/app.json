{
  "expo": {
    "name": "Stoke",
    "slug": "stoke",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stoke",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0E",
    "ios": {
      "bundleIdentifier": "com.stoke.fitness",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.stoke.fitness"]
      }
    },
    "android": {
      "package": "com.stoke.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#0B0C0E", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }],
      "expo-secure-store",
      "expo-sqlite",
      ["expo-camera", { "cameraPermission": "Stoke uses the camera to scan barcodes and photograph meals or nutrition labels you choose to log.", "recordAudioAndroid": false }],
      ["expo-image-picker", { "photosPermission": "Stoke lets you choose meal photos and progress photos from your library." }],
      ["expo-audio", { "microphonePermission": "Stoke records short voice notes only when you hold the microphone button to log food or workouts." }],
      ["expo-localization", { "supportedLocales": { "ios": ["en", "ar"], "android": ["en", "ar"] } }],
      ["expo-notifications", { "color": "#7CF0B4" }],
      ["@kingstinct/react-native-healthkit", { "NSHealthShareUsageDescription": "Stoke reads steps, active energy, sleep, resting heart rate, heart rate variability, walking distance and body weight that you choose to share, to show recovery trends and keep your weight log in sync.", "NSHealthUpdateUsageDescription": "Stoke only reads from Apple Health. It does not write any data to it.", "background": true }],
      "react-native-health-connect",
      ["expo-build-properties", { "android": { "minSdkVersion": 26, "compileSdkVersion": 36, "targetSdkVersion": 36 } }],
      ["expo-widgets", {
        "bundleIdentifier": "com.stoke.fitness.widgets",
        "groupIdentifier": "group.com.stoke.fitness",
        "widgets": [
          { "name": "CaloriesLeft", "displayName": "Calories left", "description": "Calories and protein left today.", "ios": { "supportedFamilies": ["systemSmall", "systemMedium", "accessoryCircular"], "initialLayout": "./src/features/native/widgets/CaloriesLeftWidget.tsx" } },
          { "name": "NextWorkout", "displayName": "Next workout", "description": "Your next session, one tap to start.", "ios": { "supportedFamilies": ["systemSmall", "accessoryRectangular"], "initialLayout": "./src/features/native/widgets/NextWorkoutWidget.tsx" } }
        ]
      }],
      "@bacons/apple-targets",
      "./modules/stoke-intents/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
