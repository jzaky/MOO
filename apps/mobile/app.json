{
  "expo": {
    "name": "MOO",
    "slug": "moo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0E",
    "ios": {
      "bundleIdentifier": "com.moo.fitness",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.moo.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#0B0C0E", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }],
      "expo-secure-store",
      "expo-sqlite",
      ["expo-camera", { "cameraPermission": "MOO uses the camera to scan barcodes and photograph meals or nutrition labels you choose to log.", "recordAudioAndroid": false }],
      ["expo-image-picker", { "photosPermission": "MOO lets you choose meal photos and progress photos from your library." }],
      ["expo-audio", { "microphonePermission": "MOO records short voice notes only when you hold the microphone button to log food or workouts." }],
      "expo-localization",
      ["expo-notifications", { "color": "#7CF0B4" }],
      ["@kingstinct/react-native-healthkit", { "NSHealthShareUsageDescription": "MOO reads steps, active energy, sleep, resting heart rate, heart rate variability, walking distance and body weight that you choose to share, to show recovery trends and keep your weight log in sync.", "NSHealthUpdateUsageDescription": "MOO only reads from Apple Health. It does not write any data to it.", "background": true }],
      "react-native-health-connect",
      ["expo-build-properties", { "android": { "minSdkVersion": 26, "compileSdkVersion": 36, "targetSdkVersion": 36 } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
