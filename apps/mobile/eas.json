{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "pnpm": "10.28.0",
      "env": { "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-YOUR-API-HOST" }
    },
    "first-device": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "STOKE_NATIVE_EXTRAS": "0" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": { "ios": {} }
  }
}
